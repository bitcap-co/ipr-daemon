[Unit]
Description=IPR Daemon
After=network-online.target
Wants=network-online.target

[Service]
Environment=IPRD_CONFIG=/etc/iprd/config.toml
EnvironmentFile=-/etc/iprd.conf
User=root
Group=root
LogsDirectory=iprd
LogsDirectoryMode=0755
ExecCondition=/usr/bin/test -f ${IPRD_CONFIG}
ExecStart=/usr/bin/iprd -c ${IPRD_CONFIG}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
