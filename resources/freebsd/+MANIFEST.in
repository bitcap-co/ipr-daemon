name: iprd
version: "%%VERSION%%"
origin: net/iprd
comment: "ASIC Miner IP Report listener"
maintainer: matt@bitcap.co
www: https://github.com/bitcap-co/ipr-daemon
prefix: /usr/local
arch: "%%ARCH%%"
desc: <<EOD
iprd listens for IP Report packets broadcast by ASIC miners on the local
network and forwards them over TCP.
EOD
scripts: {
  post-install: <<EOS
#!/bin/sh
sysrc iprd_enable=YES
iprd_config=$(sysrc -n iprd_config 2>/dev/null || true)
if [ -z "${iprd_config}" ]; then
    iprd_config=/usr/local/etc/iprd/config.toml
fi
if [ -f "${iprd_config}" ]; then
    service iprd start
else
    echo "iprd is enabled but was not started: no configuration at ${iprd_config}"
    echo "Run 'iprd -setup', then 'service iprd start'."
fi
EOS
  pre-deinstall: <<EOS
#!/bin/sh
if service iprd onestatus >/dev/null 2>&1; then
    service iprd stop
fi
sysrc -x iprd_enable >/dev/null 2>&1 || true
EOS
}
